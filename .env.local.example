# Copie este arquivo para .env.local na raiz do projeto e preencha sua chave:
#   cp .env.local.example .env.local
#
# As variáveis precisam do prefixo VITE_ para serem expostas ao código do navegador.

# Chave da SerpApi para buscar preços reais de voos (https://serpapi.com).
# Se ficar vazia, o app usa dados simulados (mock).
# Atenção: chamar a SerpApi direto do navegador pode falhar por CORS;
# em produção use um proxy/backend e não exponha a chave no cliente.
VITE_SERPAPI_API_KEY=

# Modelo padrão usado por integrações cliente/servidor (apenas informativo na UI).
VITE_DEFAULT_MODEL=gpt-5-mini
